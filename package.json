{
  "name": "ourcamp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @ourcamp/desktop tauri dev",
    "livekit": "docker compose -f dev/compose.yaml up",
    "livekit:down": "docker compose -f dev/compose.yaml down",
    "livekit:fetch": "node dev/fetch-livekit.ts",
    "server": "cargo run -p oc-server -- --data target/camp-data",
    "server:docker": "cargo run -p oc-server -- --data target/camp-data --livekit-url ws://127.0.0.1:7880",
    "server:window": "pnpm --filter @ourcamp/server tauri dev",
    "server:pack": "node dev/pack-server.ts",
    "test": "pnpm -r test && cargo test",
    "typecheck": "pnpm -r typecheck",
    "lint:rust": "cargo clippy --all-targets -- -D warnings && cargo fmt --check"
  }
}
