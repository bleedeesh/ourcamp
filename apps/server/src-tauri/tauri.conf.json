{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OurCamp Server",
  "version": "0.1.0",
  "identifier": "app.ourcamp.server",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OurCamp Server",
        "width": 480,
        "height": 720,
        "minWidth": 400,
        "minHeight": 540,
        "decorations": false,
        "backgroundColor": "#101010"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
