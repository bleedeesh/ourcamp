{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OurCamp",
  "version": "0.1.0",
  "identifier": "app.ourcamp.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OurCamp",
        "width": 380,
        "height": 720,
        "minWidth": 320,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#101010"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "OurCamp",
    "shortDescription": "Голосовой клиент OurCamp",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
