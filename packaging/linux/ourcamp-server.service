# OurCamp Server under systemd (ADR-0043). Installed by install.sh.
[Unit]
Description=OurCamp Server
Documentation=https://github.com/bleedeesh/ourcamp
After=network-online.target
Wants=network-online.target

[Service]
User=ourcamp
Group=ourcamp
# OURCAMP_ARGS: --host, --tls-cert… (see the file).
EnvironmentFile=/etc/ourcamp/server.env
# Unquoted $OURCAMP_ARGS: systemd splits it into words.
ExecStart=/opt/ourcamp/oc-server --data /var/lib/ourcamp $OURCAMP_ARGS
# /var/lib/ourcamp: the database, the camp's own certificate, LiveKit's key.
StateDirectory=ourcamp
StateDirectoryMode=0700
# SIGTERM goes to oc-server alone: it stops its LiveKit itself, then exits.
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# A port below 1024 (--bind 0.0.0.0:443), and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Netlink: LiveKit lists the network interfaces for its ICE candidates.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
